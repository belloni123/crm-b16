POSTGRES_DB="crm_b16"
POSTGRES_USER="crm_user"
POSTGRES_PASSWORD="replace_with_a_long_random_password"
DATABASE_URL="postgresql://crm_user:replace_with_a_long_random_password@postgres:5432/crm_b16?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_a_long_random_secret"
WEBHOOK_ENCRYPTION_KEY="replace_with_an_independent_long_random_secret"

EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
# Obrigatório e exclusivo por ambiente em staging/produção; também autentica o webhook legado.
EVOLUTION_WEBHOOK_SECRET=""

RESEND_API_KEY=""
MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Fundação omnichannel. Em staging, o kill switch deve permanecer true.
DEPLOYMENT_ENV="local"
DEPLOYMENT_VERSION="local"
OUTBOUND_INTEGRATIONS_DISABLED="true"
REDIS_URL="redis://redis:6379"
QUEUE_PREFIX="crm-b16-local"
CHANNEL_CREDENTIALS_ENCRYPTION_KEY="replace_with_32_bytes_encoded_as_base64_or_64_hex_chars"
CHANNEL_CREDENTIALS_KEY_ID="local-v1"
CHANNEL_CREDENTIALS_PREVIOUS_KEY=""
CHANNEL_CREDENTIALS_PREVIOUS_KEY_ID=""
PROVIDER_EVENT_ENCRYPTION_KEY="replace_with_a_different_32_byte_key"
PROVIDER_EVENT_KEY_ID="provider-events-local-v1"
PROVIDER_EVENT_PREVIOUS_KEY=""
PROVIDER_EVENT_PREVIOUS_KEY_ID=""
PROVIDER_EVENT_RETENTION_DAYS="30"
META_WEBHOOK_VERIFY_TOKEN="replace_with_staging_only_value"
META_APP_SECRET="replace_with_staging_only_value"
EVOLUTION_FOUNDATION_WEBHOOK_SECRET="replace_with_staging_only_value"
OBJECT_STORAGE_ENABLED="false"
TRUST_PROXY="false"
WEBHOOK_RATE_LIMIT_ORIGIN="120"
WEBHOOK_RATE_LIMIT_CONNECTION="600"

# Somente para comandos manuais em clone isolado ou staging sintético.
DB_SAFETY_SCOPE="isolated"
BACKFILL_TARGET_CONFIRMATION="isolated:evolution-foundation"
BACKFILL_BATCH_SIZE="50"
BACKFILL_TIMEOUT_MS="900000"
DUAL_WRITE_TEST_CONFIRMATION="staging:synthetic-only"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# Seed local opcional. Nunca configure estas variáveis no Coolify.
ALLOW_DESTRUCTIVE_SEED="false"
SEED_SUPERADMIN_NAME="Administrador local"
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
SEED_SECOND_ADMIN_NAME="Segundo administrador local"
SEED_SECOND_ADMIN_EMAIL=""
SEED_SECOND_ADMIN_PASSWORD=""
SEED_MEMBER_NAME="Membro local"
SEED_MEMBER_EMAIL=""
SEED_MEMBER_PASSWORD=""
