datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                @id @default(uuid())
  name                  String?
  email                 String                @unique
  passwordHash          String
  role                  String                @default("USER") // "SUPERADMIN" or "USER"
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  resetToken            String?               @unique
  resetTokenExpires     DateTime?
  lgpdAccepted          Boolean               @default(false)
  lgpdAcceptedAt        DateTime?
  memberships           Membership[]
  activities            Activity[]
  assignedLeads         Lead[]                @relation("LeadAssignment")
  calendarIntegrations  CalendarIntegration[]
  tasks                 Task[]
  assignedConversations Conversation[]        @relation("ConversationAssignment")
  auditEvents           AuditEvent[]          @relation("AuditActor")
}

model Project {
  id                       String                  @id @default(uuid())
  name                     String
  description              String?
  lastAssignedCommercialId String?
  apiKeyHash               String?
  apiKeyPrefix             String?                 @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  memberships              Membership[]
  pipelines                Pipeline[]
  leads                    Lead[]
  tasks                    Task[]
  tags                     Tag[]
  webhookEndpoints         WebhookEndpoint[]
  whatsAppInstances        WhatsAppInstance[]
  origins                  Origin[]
  lostStatuses             LostStatus[]
  customFieldDefinitions   CustomFieldDefinition[]
  forms                    Form[]
  channelConnections       ChannelConnection[]
  contactIdentities        ContactIdentity[]
  providerEvents           ProviderEvent[]
  outboxEvents             OutboxEvent[]
  mediaObjects             MediaObject[]
  features                 ProjectFeature[]
  auditEvents              AuditEvent[]
  omnichannelConversations Conversation[]          @relation("ConversationProject")
  omnichannelMessages      Message[]               @relation("MessageProject")
}

model Membership {
  id                     String  @id @default(uuid())
  role                   String  @default("MEMBER") // "PROJECT_ADMIN" or "MEMBER"
  userId                 String
  projectId              String
  isDesignatedCommercial Boolean @default(false)
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Pipeline {
  id              String          @id @default(uuid())
  name            String
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages          Stage[]
  pipelineEntries PipelineEntry[]
  forms           Form[]
}

model Stage {
  id              String          @id @default(uuid())
  name            String
  order           Int             @default(0)
  color           String          @default("#9FE870")
  pipelineId      String
  pipeline        Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineEntries PipelineEntry[]
  forms           Form[]
}

model Origin {
  id               String            @id @default(uuid())
  name             String
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads            Lead[]
  webhookEndpoints WebhookEndpoint[]
  forms            Form[]
}

model LostStatus {
  id              String          @id @default(uuid())
  reason          String
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipelineEntries PipelineEntry[]
}

model Lead {
  id                String             @id @default(uuid())
  name              String
  email             String?
  phone             String?
  company           String?
  priority          String             @default("MEDIA") // "BAIXA", "MEDIA", "ALTA"
  projectId         String
  originId          String?
  assignedUserId    String?
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  origin            Origin?            @relation(fields: [originId], references: [id], onDelete: SetNull)
  assignedUser      User?              @relation("LeadAssignment", fields: [assignedUserId], references: [id], onDelete: SetNull)
  tags              Tag[]              @relation("LeadToTag")
  tasks             Task[]
  activities        Activity[]
  conversations     Conversation[]
  customFieldValues CustomFieldValue[]
  pipelineEntries   PipelineEntry[]
  contactIdentities ContactIdentity[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  referrer          String?
  landingPage       String?
}

model PipelineEntry {
  id           String      @id @default(uuid())
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipelineId   String
  pipeline     Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId      String
  stage        Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  value        Float       @default(0.0)
  status       String      @default("ACTIVE") // "ACTIVE", "ARCHIVED", "LOST"
  lostStatusId String?
  lostStatus   LostStatus? @relation(fields: [lostStatusId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([leadId, pipelineId])
}

model CustomFieldDefinition {
  id              String             @id @default(uuid())
  name            String
  internalName    String
  type            String // TEXT, LONG_TEXT, NUMBER, CURRENCY, DATE, DATETIME, PHONE, EMAIL, URL, SELECT, MULTI_SELECT, CHECKBOX, BOOLEAN
  entityType      String             @default("LEAD") // "LEAD" or "OPPORTUNITY"
  options         String? // JSON array of configurable options
  helpText        String?
  defaultValue    String?
  validationRules String? // JSON object with validation rules
  required        Boolean            @default(false)
  isActive        Boolean            @default(true)
  order           Int                @default(0)
  deletedAt       DateTime?
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values          CustomFieldValue[]
  formFields      FormField[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([projectId, internalName])
  @@index([projectId, isActive, order])
}

model CustomFieldValue {
  id                String                @id @default(uuid())
  fieldDefinitionId String
  definition        CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value             String

  @@unique([fieldDefinitionId, leadId])
  @@index([leadId])
}

model Tag {
  id        String  @id @default(uuid())
  name      String
  color     String  @default("#9FE870")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads     Lead[]  @relation("LeadToTag")
}

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  dueDate          DateTime?
  status           String    @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED"
  leadId           String?
  projectId        String
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId    String?
  microsoftEventId String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Activity {
  id        String   @id @default(uuid())
  type      String   @default("LOG") // "LOG", "COMMENT", "STATUS_CHANGE"
  content   String
  leadId    String
  userId    String?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model WebhookEndpoint {
  id               String       @id @default(uuid())
  name             String
  token            String       @unique
  direction        String       @default("INCOMING") // INCOMING or OUTGOING
  url              String?
  method           String       @default("POST")
  isActive         Boolean      @default(true)
  events           String       @default("[]") // JSON array of event names
  payloadFields    String       @default("[]") // Ordered JSON payload mapping
  headersEncrypted String?
  timeoutMs        Int          @default(10000)
  targetStageId    String?
  projectId        String
  originId         String?
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  origin           Origin?      @relation(fields: [originId], references: [id], onDelete: SetNull)
  fieldMapping     String       @default("{}") // Legacy incoming field mappings
  webhookLogs      WebhookLog[]
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([projectId, direction, isActive])
}

model WebhookLog {
  id           String          @id @default(uuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  payload      String
  status       String          @default("SUCCESS") // "SUCCESS" or "ERROR"
  errorDetails String?
  event        String?
  statusCode   Int?
  responseBody String?
  attempt      Int             @default(1)
  durationMs   Int?
  createdAt    DateTime        @default(now())

  @@index([webhookId, createdAt])
}

model WhatsAppInstance {
  id                String             @id @default(uuid())
  name              String
  instanceName      String             @unique
  token             String?
  status            String             @default("DISCONNECTED") // "CONNECTED", "DISCONNECTED"
  type              String             @default("WHATSAPP") // Preparado para canais futuros
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  channelConnection ChannelConnection?
  createdAt         DateTime           @default(now())
  archivedAt        DateTime?
}

model Conversation {
  id                       String             @id @default(uuid())
  whatsappId               String // phone number
  name                     String
  lastMessageAt            DateTime           @default(now())
  leadId                   String?
  lead                     Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  instanceId               String
  instance                 WhatsAppInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages                 Message[]
  projectId                String?
  project                  Project?           @relation("ConversationProject", fields: [projectId], references: [id], onDelete: SetNull)
  channelConnectionId      String?
  channelConnection        ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  contactIdentityId        String?
  contactIdentity          ContactIdentity?   @relation(fields: [contactIdentityId], references: [id], onDelete: SetNull)
  externalConversationId   String?
  channel                  String?
  status                   String?
  assignedUserId           String?
  assignedUser             User?              @relation("ConversationAssignment", fields: [assignedUserId], references: [id], onDelete: SetNull)
  lastInboundAt            DateTime?
  lastOutboundAt           DateTime?
  customerCareWindowEndsAt DateTime?
  updatedAt                DateTime?

  @@unique([whatsappId, instanceId])
  @@index([projectId, channel, status])
  @@index([channelConnectionId, lastMessageAt])
}

model Message {
  id                  String             @id @default(uuid())
  remoteId            String?
  content             String
  direction           String // "INBOUND" or "OUTBOUND"
  status              String             @default("SENT") // "SENT", "DELIVERED", "READ"
  messageType         String             @default("TEXT") // "TEXT", "IMAGE", "DOCUMENT", "AUDIO"
  mediaUrl            String? // URL para arquivos de mídia
  senderName          String?
  conversationId      String
  conversation        Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  projectId           String?
  project             Project?           @relation("MessageProject", fields: [projectId], references: [id], onDelete: SetNull)
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  providerMessageId   String?
  idempotencyKey      String?
  errorCode           String?
  errorDetailRedacted String?
  acceptedAt          DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  replyToMessageId    String?
  replyToMessage      Message?           @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies             Message[]          @relation("MessageReplies")
  mediaObjectId       String?
  mediaObject         MediaObject?       @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  metadata            String?
  updatedAt           DateTime?

  @@index([projectId, createdAt])
  @@index([channelConnectionId, providerMessageId])
}

model Form {
  id             String      @id @default(uuid())
  name           String
  token          String      @unique
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String
  stage          Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  originId       String?
  origin         Origin?     @relation(fields: [originId], references: [id], onDelete: SetNull)
  successMessage String      @default("Formulário enviado com sucesso!")
  redirectUrl    String?
  isActive       Boolean     @default(true)
  fields         FormField[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model FormField {
  id                      String                 @id @default(uuid())
  formId                  String
  form                    Form                   @relation(fields: [formId], references: [id], onDelete: Cascade)
  type                    String // "SYSTEM" or "CUSTOM"
  fieldName               String // "name", "email", "phone" for SYSTEM
  customFieldDefinitionId String?
  customFieldDefinition   CustomFieldDefinition? @relation(fields: [customFieldDefinitionId], references: [id], onDelete: SetNull)
  label                   String
  required                Boolean                @default(false)
  order                   Int                    @default(0)
}

model CalendarIntegration {
  id           String    @id @default(uuid())
  provider     String // "GOOGLE" or "MICROSOFT"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  email        String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model ChannelConnection {
  id                         String            @id @default(uuid())
  projectId                  String
  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider                   String
  channel                    String
  name                       String
  status                     String            @default("DISABLED")
  externalBusinessId         String?
  externalWabaId             String?
  externalPhoneNumberId      String?
  externalPageId             String?
  externalInstagramAccountId String?
  credentialsEncrypted       String?
  credentialsKeyId           String?
  tokenExpiresAt             DateTime?
  capabilitiesSnapshot       String?
  metadata                   String?
  lastHealthAt               DateTime?
  lastErrorCode              String?
  isActive                   Boolean           @default(false)
  archivedAt                 DateTime?
  legacyWhatsAppInstanceId   String?           @unique
  legacyWhatsAppInstance     WhatsAppInstance? @relation(fields: [legacyWhatsAppInstanceId], references: [id], onDelete: SetNull)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  contactIdentities          ContactIdentity[]
  providerEvents             ProviderEvent[]
  conversations              Conversation[]
  messages                   Message[]

  @@index([projectId, provider, channel, isActive])
}

model ContactIdentity {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  channel             String
  externalUserId      String
  address             String?
  normalizedAddress   String?
  displayName         String?
  avatarUrl           String?
  leadId              String?
  lead                Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  conversations       Conversation[]

  @@unique([channelConnectionId, externalUserId])
  @@index([projectId, channel, normalizedAddress])
  @@index([leadId])
}

model ProviderEvent {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  provider            String
  externalEventKey    String
  eventType           String
  payloadHash         String
  payloadEncrypted    String?
  status              String            @default("RECEIVED")
  attempts            Int               @default(0)
  occurredAt          DateTime?
  receivedAt          DateTime          @default(now())
  processedAt         DateTime?
  lastErrorCode       String?
  retentionUntil      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([channelConnectionId, externalEventKey])
  @@index([projectId, status, receivedAt])
  @@index([retentionUntil])
}

model OutboxEvent {
  id                    String    @id @default(uuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aggregateType         String
  aggregateId           String
  eventType             String
  payload               String
  idempotencyKey        String    @unique
  status                String    @default("PENDING")
  attempts              Int       @default(0)
  availableAt           DateTime  @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  lockedUntil           DateTime?
  lastAttemptAt         DateTime?
  deadLetteredAt        DateTime?
  deadLetterPublishedAt DateTime?
  maxAttempts           Int       @default(5)
  targetQueue           String    @default("provider-events")
  publishedAt           DateTime?
  lastErrorCode         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedUntil])
  @@index([projectId, createdAt])
}

model MediaObject {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageKey      String
  bucket          String
  contentType     String
  sizeBytes       BigInt
  checksum        String
  scanStatus      String    @default("PENDING")
  providerMediaId String?
  retentionUntil  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@unique([projectId, storageKey])
  @@index([projectId, retentionUntil])
}

model ProjectFeature {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key           String
  enabled       Boolean  @default(false)
  configuration String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId, enabled])
}

model AuditEvent {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUserId      String?
  actorUser        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action           String
  resourceType     String
  resourceId       String
  correlationId    String?
  reason           String?
  metadataRedacted String?
  createdAt        DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([correlationId])
}

model BackfillCheckpoint {
  id            String    @id @default(uuid())
  key           String    @unique
  cursor        String?
  status        String    @default("PENDING")
  countsJson    String?
  conflictsJson String?
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
}
